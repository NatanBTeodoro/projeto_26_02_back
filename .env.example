# Valores locais. Copie para .env e ajuste aí.
# No Render estas variáveis vêm do serviço e do banco, e vencem este arquivo.

PGHOST=localhost
PGPORT=5432
PGDATABASE=menu_engineering
PGUSER=quadrante
PGPASSWORD=quadrante
PGSSLMODE=disable
DB_POOL=5

PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173

SEMENTE=true
SEMENTE_EMAIL=admin@admin.com
SEMENTE_SENHA=Admin123
SEMENTE_TI_EMAIL=ti@admin.com
SEMENTE_TI_SENHA=Ti123!
